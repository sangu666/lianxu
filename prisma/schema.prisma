generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 记录单位必须明确；社区动作的 unspecified 只能用于目录，不能用于训练记录。
enum ExerciseUnit {
  reps
  seconds
  unspecified
}

enum WorkoutStatus {
  active
  completed
}

/// 密码只保存加盐哈希；旧阶段虚构账户允许为空，不能凭空获得登录能力。
model User {
  /// 用户唯一编号（UUID，主键）；个人数据通过此编号确定归属。
  id           String         @id @default(uuid()) @db.Uuid
  /// 登录邮箱，注册时去除首尾空格并转小写，大小写不敏感唯一；旧虚构账户允许为空，邮箱尚未验证。
  email        String?        @unique @db.VarChar(254)
  /// 加盐 scrypt 密码哈希，含算法版本、随机盐和结果；不是明文密码。为空的旧账户不能登录。
  passwordHash String?
  /// 账户创建时刻，带时区时间戳；默认数据库当前时间。
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  profile      Profile?
  planVersions PlanVersion[]
  workouts     Workout[]
  weights      WeightEntry[]
  sessions     Session[]
  imports      ImportJob[]
  receipts     WriteReceipt[]
}

/// 成功写入与回执同事务提交；同账户同请求编号只能代表同一种操作。
model WriteReceipt {
  /// 所属账户（UUID），删除账户时级联清理；不同账户编号互不影响。
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 客户端随机 UUID，请求重试必须沿用；不是训练或组编号。
  key       String   @db.Uuid
  /// 方法、路径和规范化请求体的 SHA-256，防止重用编号提交不同内容。
  digest    String   @db.Char(64)
  /// 首次成功的响应 JSON；响应丢失时返回同一结果，不重复修改业务记录。
  result    Json
  /// 首次提交时刻（带时区）；当前保留至账户删除，不能提前删掉而允许旧请求再次写入。
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, key])
}

/// 备份迁移预览与确认凭据；待确认内容短期保留，成功后只留摘要防止重复导入。
model ImportJob {
  /// 预览编号（UUID）；确认与取消通过此编号定位，必须属于登录账户。
  id          String   @id @default(uuid()) @db.Uuid
  /// 所属账户编号，关联 User.id，用户删除时级联清理。
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 规范化备份事实的 SHA-256；忽略导出时刻与训练 revision，同账户唯一，用于重复确认去重。
  digest      String   @db.Char(64)
  /// 预览时账户业务数据指纹；确认前重新核对，变化则拒绝，不覆盖另一页面修改。
  fingerprint String   @db.Char(64)
  /// 校验后的待导入备份 JSON；只在 pending 时暂存，确认、取消或到期后清理，不保存照片。
  payload     Json?
  /// pending 待确认、confirmed 已确认、expired 已过期；不是训练状态。
  status      String   @db.VarChar(20)
  /// 预览/成功摘要，保存条数和版本对应，不包含个人资料、原照片或密码。
  result      Json
  /// 本次预览截止时刻；30 分钟后不能确认，后台每分钟清理过期内容。
  expiresAt   DateTime @db.Timestamptz(3)
  /// 预览创建时刻，带时区时间戳，默认数据库当前时间。
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, digest])
  @@index([status, expiresAt])
}

/// 原始随机会话令牌仅在 Cookie 中，数据库只保存 SHA-256；退出删除即可撤销。
model Session {
  /// 会话令牌的 SHA-256 哈希，64 位十六进制文本（主键）；不是可直接用于登录的原始令牌。
  tokenHash String   @id @db.Char(64)
  /// 自动递增且唯一的会话创建序号；同一毫秒创建的会话也能确定先后，用于撤销最早的会话。
  sequence  BigInt   @unique @default(autoincrement())
  /// 所属用户编号，关联 User.id；删除用户时级联删除其会话。
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 会话创建时刻，带时区时间戳。
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  /// 会话绝对过期时刻，必须晚于创建时刻；当前有效期七天，不随访问延期。
  expiresAt DateTime @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// 当前资料保留原型字段 JSON，避免迁移时丢失设备、限制与缺省字段。
model Profile {
  /// 所属用户编号，关联 User.id，同时为主键；每个用户最多一份当前资料。
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 个人资料 JSON：age 年龄（岁）、height 身高（厘米）、weight 体重（千克）、days 每周训练次数、experience 经验、equipment 环境、goal 目标；可选 availableEquipment 设备、sessionMinutes 分钟、movementPreference 偏好、excludedPatterns 排除类型、restrictionNotes 备注。详细枚举见 docs/PROFILE-DATA.md；备注不作自动医疗判断。
  data      Json
  /// 资料修改版本，初始为 1；保存时提交 expectedRevision，版本不一致返回冲突，不应手工覆盖版本。
  revision  Int      @default(1)
  /// 资料最后更新时间，带时区时间戳；由 Prisma 写入时维护，直接 SQL 更新不会自动刷新此字段。
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// 公开动作目录；稳定 ID 沿用 lianxu: / hasaneyldrm:，译名变化不改变身份。
model Exercise {
  /// 动作稳定编号（主键），例如 lianxu:plank 或 hasaneyldrm:2137；译名改变不改变动作身份。
  id               String       @id @db.VarChar(100)
  /// 中文动作显示名；社区译名尚未经过专业教练逐项审校。
  nameZh           String       @db.VarChar(200)
  /// 来源中的英文原名；内置动作没有英文名时为空字符串。
  nameEn           String       @db.VarChar(200)
  /// 训练部位的原始标签，例如 shoulders 肩部、waist 腰腹；API 按原始标签筛选，前端显示中文。
  bodyPart         String       @db.VarChar(80)
  /// 所需设备的目录标签；社区资料使用原始标签，内置资料使用练序设备编号，不应直接视为统一枚举。
  equipment        String       @db.VarChar(80)
  /// 主要目标肌群的目录标签，例如 quads 股四头肌、abs 腹肌。
  target           String       @db.VarChar(80)
  /// 辅助肌群标签数组；空数组表示没有提供辅助肌群资料。
  secondaryMuscles String[]
  /// 中文动作教学步骤数组，按数组顺序展示。
  stepsZh          String[]
  /// 英文来源教学步骤数组；没有提供时为空数组。
  stepsEn          String[]
  /// 记录单位：reps 次数、seconds 秒、unspecified 未指定；社区动作进入训练前必须确认明确单位。
  unit             ExerciseUnit
  /// 动作来源：builtin 练序内置文字、community 社区文字资料。
  origin           String       @db.VarChar(40)
  /// 来源中的原始动作编号；与练序统一稳定编号 id 区分。
  sourceId         String       @db.VarChar(100)
  /// 社区来源 Git 提交号，用于追溯固定数据版本；内置动作可为空。
  sourceCommit     String?      @db.VarChar(40)
  /// 常见错误或动作注意事项，可为空；不代表个体医疗诊断。
  mistake          String?
  /// 文字资料最近更新时间；由 Prisma 更新维护，直接 SQL 更新不会自动刷新。
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  @@index([bodyPart, equipment])
  @@index([origin])
}

/// 不可变版本快照，包含资料、逐动作目标和来源；当前版本由最大 version 得出。
model PlanVersion {
  /// 计划版本记录唯一编号（UUID，主键）；不是用户可见的递增版本号。
  id        String    @id @default(uuid()) @db.Uuid
  /// 所属用户编号，关联 User.id；与 version 共同构成唯一约束。
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 同一用户的计划版本号，从 1 开始；不是软件版本或备份格式版本。
  version   Int
  /// 不可变计划 JSON 快照：包含 version、reason、profile、adjusted、days，可附 editablePlan 手动/外部草稿及 planOverrides 替代清单；days.actions 保存 exerciseId、name、unit、sets、targetMin、targetMax、restSeconds、reason、acknowledged。当前为规则模板，不是真实 AI；旧版本不得覆盖。
  snapshot  Json
  /// 计划版本创建时刻，带时区时间戳。
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  workouts  Workout[]

  @@unique([userId, version])
}

/// 保留原型训练 ID；不同账户可导入相同 ID，不把名称当作动作身份。
model Workout {
  /// 所属用户编号，关联 User.id；与 id 组成联合主键，并限定引用计划的账户归属。
  userId      String            @db.Uuid
  /// 训练稳定编号；同一编号可以在不同账户独立存在，不按日期或名称识别训练。
  id          String            @db.VarChar(160)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 本次训练采用的计划版本号；与 userId 关联 PlanVersion，后续新计划不改写此记录。
  planVersion Int
  plan        PlanVersion       @relation(fields: [userId, planVersion], references: [userId, version], onDelete: Restrict)
  /// 训练采用的计划名称快照；保留当时名称，不随当前计划改名而变化。
  planName    String            @db.VarChar(200)
  /// 用户本地训练日历日期（YYYY-MM-DD），不是 UTC 起止时刻，也不表示某个瞬间。
  date        DateTime          @db.Date
  /// 训练状态：active 进行中、completed 已完成；每账户最多一个 active。
  status      WorkoutStatus
  /// 训练开始时刻，带时区时间戳；旧版归档缺失时为空，不推测时间。
  startedAt   DateTime?         @db.Timestamptz(3)
  /// 训练结束时刻，带时区时间戳；未完成或旧记录缺失时为空，不得早于已知开始时刻。
  completedAt DateTime?         @db.Timestamptz(3)
  /// 训练备注或旧数据归档说明；默认空字符串。
  notes       String            @default("")
  /// 记录来源：manual 新建训练、legacy 旧版归档；不是动作库来源。
  origin      String            @db.VarChar(40)
  /// 训练修改版本，初始为 1，每次训练事务保存递增；修改与删除提交 expectedRevision，冲突返回 409，避免旧页面覆盖新记录。
  revision    Int               @default(1)
  exercises   WorkoutExercise[]

  @@id([userId, id])
  @@index([userId, date])
}

/// 当次动作名称、单位、目标均为快照；未知旧动作也保留，不强行关联目录外键。
model WorkoutExercise {
  /// 所属用户编号；与 workoutId、id 组成联合主键，限定训练动作归属。
  userId       String       @db.Uuid
  /// 所属训练编号；与 userId 关联 Workout，删除训练时级联删除动作实例。
  workoutId    String       @db.VarChar(160)
  /// 本次训练内的动作实例编号，用于定位编辑；不是公共动作库 exerciseId。
  id           String       @db.VarChar(160)
  workout      Workout      @relation(fields: [userId, workoutId], references: [userId, id], onDelete: Cascade)
  /// 跨训练比较用的稳定动作标识；保留旧版未知动作，不设置强制目录外键；历史身份禁止修改。
  exerciseId   String       @db.VarChar(200)
  /// 当次动作名称快照，不随目录译名改变。
  name         String       @db.VarChar(200)
  /// 实际记录单位：reps 次数或 seconds 秒；不允许 unspecified，保存后禁止改变单位。
  unit         ExerciseUnit
  /// 动作在本次训练中的排列位置，从 0 开始；同一训练中位置唯一。
  position     Int
  /// 当时计划目标 JSON，可为空以兼容旧记录：sets 组数、targetMin/targetMax 次数或秒数、restSeconds 休息秒数、reason 安排说明；单位由外层 unit 决定，不是实际完成成绩。
  prescription Json?
  sets         WorkoutSet[]

  @@id([userId, workoutId, id])
  @@unique([userId, workoutId, position])
  @@index([userId, exerciseId, unit])
}

/// loadKg 为千克，value 按所属动作单位表示次数或秒数；RIR 可缺省。
model WorkoutSet {
  /// 所属用户编号，与 workoutId、workoutExerciseId、id 组成联合主键。
  userId            String          @db.Uuid
  /// 所属训练编号，与 userId 共同限定训练归属。
  workoutId         String          @db.VarChar(160)
  /// 所属当次动作实例编号，关联 WorkoutExercise.id；不是动作库编号 exerciseId。
  workoutExerciseId String          @db.VarChar(160)
  /// 实际训练组的稳定编号；不能以数值相同判定同一组。
  id                String          @db.VarChar(160)
  exercise          WorkoutExercise @relation(fields: [userId, workoutId, workoutExerciseId], references: [userId, workoutId, id], onDelete: Cascade)
  /// 组在当前动作内的排列位置，从 0 开始，当前动作内唯一。
  position          Int
  /// 实际负重，单位千克，十进制保留三位小数；录入边界 0–400 千克，不是推荐负重。
  loadKg            Decimal         @db.Decimal(8, 3)
  /// 实际完成数量，按所属动作 unit 解释：reps 为 1–100 次，seconds 为 1–3600 秒；不能将秒数当次数。
  value             Int
  /// 估计剩余次数：0、1、2、3；3 表示至少三次，缺失时为空，不等于实际完成次数。
  rir               Int?
  /// 是否报告疼痛或不适（true 是、false 否，默认 false）；是主观反馈，不是诊断结果。
  pain              Boolean         @default(false)

  @@id([userId, workoutId, workoutExerciseId, id])
  @@unique([userId, workoutId, workoutExerciseId, position])
}

/// 一天可记录多次体重；使用稳定 ID 区分，不按数值相同去重。
model WeightEntry {
  /// 所属用户编号，关联 User.id；与 id 组成联合主键。
  userId String   @db.Uuid
  /// 体重记录稳定编号；不是测量日期。
  id     String   @db.VarChar(160)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 用户本地测量日历日期（YYYY-MM-DD）。
  date   DateTime @db.Date
  /// 测量体重，单位千克，十进制保留三位小数，必须大于 0；与 Profile 中当前体重资料区分。
  kg     Decimal  @db.Decimal(6, 3)

  @@id([userId, id])
  @@index([userId, date])
}
